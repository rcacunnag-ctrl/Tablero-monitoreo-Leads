# Única dependencia externa: WhatsApp. Todo lo demás corre local y sin costo.

# --- WhatsApp ---
# Número que se vincula como dispositivo (código de país + número, sin "+"). Vacío = vincular con QR.
WA_PHONE_NUMBER=15615550000
# Grupos a monitorear: JIDs (xxxx@g.us) o parte del nombre, separados por coma. Ver `npm run groups`.
WA_GROUPS=
# Carpeta donde se guarda la sesión vinculada (no compartir: equivale a tu sesión de WhatsApp)
WA_AUTH_DIR=./auth
# Segundos para unir texto + fotos consecutivas del mismo autor en una sola publicación
POST_WINDOW_SEC=90
# realtime = procesa al llegar | batch = solo encola; procesar con `npm run process`
PROCESS_MODE=realtime

# --- Extracción local ---
# Leer texto de flyers (imágenes) con OCR local (Tesseract). Más lento pero sin costo.
OCR_ENABLED=true
# Opcional: confirmar condado con el geocodificador del US Census (gratuito, sin API key, requiere internet)
USE_CENSUS_GEOCODER=true
TARGET_COUNTIES=Palm Beach,Broward,Martin

# --- Panel web local ---
DASHBOARD_PORT=3000
# 127.0.0.1 = solo esta máquina. En un servidor, accede con túnel SSH (ver docs/DESPLIEGUE.md).
DASHBOARD_HOST=127.0.0.1

DATA_DIR=./data

# Tier 1: usuarios que ejecutan el comp-analysis-report y lanzamiento automático (por habilitar)
TIER1_USERS=Andres,Carlos,Jaime
TIER1_SKILL_ENABLED=false
# Criterios de Tier 1 automático: margen (ARV - precio) / ARV >= CRIT_MARGEN_MIN % y precio < CRIT_PRECIO_MAX
CRIT_MARGEN_MIN=60
CRIT_PRECIO_MAX=300000
# Informes Tier 1 automáticos que pueden empezar por día (America/New_York); los demás esperan
TIER1_AUTO_MAX_DIA=3
# PCs ejecutores y modelo/esfuerzo del Tier 1 por PC (sin entrada = predeterminado de la cuenta de ese PC)
EJECUTORES=Roberto,Andres
TIER1_AUTO_EJECUTOR=Andres
TIER1_MODELO_POR_PC=Andres=claude-fable-5-1:medium,Roberto=claude-opus-5-5:medium

# Avisos por WhatsApp con el mismo número: un resumen al grupo NOTIF_GRUPO en cada horario de NOTIF_HORARIOS
# (hora de NOTIF_TZ), solo si hay novedades. Enviar aumenta algo el riesgo de bloqueo.
NOTIF_ENABLED=false
NOTIF_GRUPO=Grupo prueba Wholesaler
NOTIF_HORARIOS=11:00,17:30
NOTIF_TZ=America/Bogota

# Vista de solo lectura para terceros (vacío = desactivada). Generar con: openssl rand -hex 24
VISTA_TOKEN=
VISTA_PORT=3001
